# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# Note: '.env' is ignored by git to protect credentials.
# ==============================================================================

# Database Connection URL: postgresql://[user]:[password]@[host]:[port]/[dbname]?[options]
DATABASE_URL=postgresql://user:password@host:port/dbname

# Examples for deployment environments:
# ------------------------------------------------------------------------------
# 1. 24/7 Neon PostgreSQL Cloud Instance:
# DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-silent-wave-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Local TimescaleDB Docker Instance:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microgrid

# 3. Pinggy Tunnel to TimescaleDB Docker Instance (Remote edge debugging):
# DATABASE_URL=postgresql://postgres:postgres@tcp.pinggy.io:44321/microgrid
