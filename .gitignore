# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Environment and sensitive credential files (CRITICAL: Never commit database credentials)
.env
.env.*
!.env.example

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution and packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
